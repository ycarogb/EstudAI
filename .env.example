# LLM — OPCIONAL
# Cada usuário pode informar a própria chave em "Configurar IA" (fica só no navegador).
# Defina uma chave aqui apenas se quiser uma chave padrão do servidor.
# Atenção: em uma instância pública, a chave do servidor fica disponível para todos os visitantes.
# OPENAI_API_KEY=
# GEMINI_API_KEY=      (chave gratuita em https://aistudio.google.com/apikey)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=  (https://openrouter.ai/keys)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER: openai | gemini | anthropic | openrouter | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
# Exemplo com Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash

# Fontes abertas
OPENALEX_EMAIL=seu@email.edu.br
SEMANTIC_SCHOLAR_API_KEY=

# Google Scholar — OPCIONAL (não há API oficial; a busca usa a SerpApi)
# Plano gratuito com 250 buscas/mês em https://serpapi.com/manage-api-key
# SERPAPI_API_KEY=

# Fontes pagas (futuro)
# SCOPUS_API_KEY=
# SCOPUS_INST_TOKEN=
# WOS_API_KEY=

# Banco
# Local (fora do Docker):
DATABASE_URL=sqlite+aiosqlite:///./estudai.db
# Docker Compose (volume compartilhado /data):
# DATABASE_URL=sqlite+aiosqlite:////data/estudai.db
# PostgreSQL (profile postgres):
# DATABASE_URL=postgresql+asyncpg://estudai:estudai@localhost:5432/estudai

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
